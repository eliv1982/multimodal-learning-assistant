# Production environment template — Stage 8B (docker-compose.prod.yml).
#
# Скопируйте в `.env.production` (НЕ `.env` — docker-compose.prod.yml
# намеренно использует отдельное имя файла, никогда не то же, что и
# локальный dev `.env`, чтобы `env_file:` не мог случайно подхватить
# чужой/несвязанный .env из текущей директории) рядом с
# docker-compose.prod.yml на production-сервере и заполните реальными
# значениями. `.env.production` в .gitignore — реальные секреты никогда не
# попадают в git. Переменные
# приложения ниже используют ТЕ ЖЕ имена, что и .env.example / исходный
# код (config.py, web_config.py, session_config.py, telegram_config.py,
# telegram_link_config.py, github_oauth_config.py, db/settings.py) —
# никаких параллельных имён не вводится.
#
# Классификация: REQUIRED — приложение не запустится без значения
# (fail closed); OPTIONAL — есть безопасный дефолт; GENERATED — сгенерируйте
# сами (команда указана); EXTERNAL — учётные данные внешнего провайдера;
# DEPLOYMENT — используется только Compose-оркестрацией/Traefik, не
# читается приложением напрямую.

# ============================================================================
# Telegram (REQUIRED, EXTERNAL)
# ============================================================================
TELEGRAM_BOT_TOKEN=

# Числовые Telegram user id, через запятую, кому разрешён доступ к боту.
# ВАЖНО: пусто = доступ запрещён всем (fail closed), а не "всем разрешено".
# Не REQUIRED для запуска, но REQUIRED для того, чтобы Telegram-канал вообще
# был кому-то доступен.
TELEGRAM_ALLOWED_USER_IDS=

# OPTIONAL — имя бота для диплинка связывания Telegram/GitHub аккаунтов
# (Stage 6C). Без него POST /api/link/telegram/start отвечает 503; всё
# остальное (включая GitHub-логин) не затронуто.
# TELEGRAM_BOT_USERNAME=

# OPTIONAL — TTL одной попытки связывания, секунды (по умолчанию 600, максимум 900).
# TELEGRAM_LINK_ATTEMPT_TTL_SECONDS=600

# ============================================================================
# OpenAI (REQUIRED, EXTERNAL) — embeddings/vision/STT/TTS/DALL-E всегда через
# официальный OpenAI API напрямую, независимо от LLM_PROVIDER ниже.
# ============================================================================
OPENAI_API_KEY=

# ============================================================================
# Основной текстовый LLM-провайдер (OPTIONAL, EXTERNAL)
# ============================================================================
# anthropic | openai. Некорректное значение — бот не запустится (fail closed).
LLM_PROVIDER=anthropic

# REQUIRED только если LLM_PROVIDER=anthropic (дефолт).
ANTHROPIC_API_KEY=

# OPTIONAL
ANTHROPIC_MODEL=claude-sonnet-5

# ============================================================================
# PostgreSQL — DEPLOYMENT (bootstraps the `postgres` service) + REQUIRED.
# ============================================================================
# docker-compose.prod.yml derives the app's DATABASE_URL from these three
# values automatically (host "mla-postgres-internal", port 5432, private
# app-internal network only) — do NOT set DATABASE_URL directly here, it
# is ignored in favor of the Compose-computed one.
#
# GENERATED: POSTGRES_PASSWORD is interpolated verbatim into a
# postgresql+psycopg:// URL (docker-compose.prod.yml's x-database-url) —
# no automatic URL-encoding is applied. The password MUST NOT contain any
# of: '@' ':' '/' '#' '%' (URI delimiter/escape characters — any of these
# would corrupt the DSN, either silently truncating/misparsing it or
# breaking the connection outright). Do NOT percent-encode the password
# to work around this: the same POSTGRES_PASSWORD value is also passed to
# the `postgres` service itself as the literal, un-encoded password
# (see the `postgres` service's `environment:` below) — percent-encoding
# only in the URL would make the DSN's password no longer match the
# actual database password.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# token_urlsafe's alphabet (A-Z a-z 0-9 - _) never produces any of the
# above characters, so it satisfies this constraint by construction —
# prefer it over hand-picking a password.
POSTGRES_USER=python_tutor
POSTGRES_PASSWORD=
POSTGRES_DB=python_tutor_bot

# ============================================================================
# Web-адаптер (REQUIRED/OPTIONAL)
# ============================================================================
# REQUIRED. GENERATED: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must be >=32 UTF-8 bytes, no whitespace anywhere — fail closed otherwise.
SESSION_SECRET_KEY=

# OPTIONAL but must stay at these production values — do not override.
# WEB_ENV=production and WEB_COOKIE_SECURE=true together are required for
# Secure/__Host- cookies over the HTTPS Traefik terminates; the app itself
# refuses to start with WEB_COOKIE_SECURE=false while WEB_ENV=production.
WEB_ENV=production
WEB_COOKIE_SECURE=true

# OPTIONAL — server-side session lifetime, seconds (default 1209600 = 14
# days, max 15552000 = 180 days).
# WEB_SESSION_TTL_SECONDS=1209600

# Baked into the accepted Stage 8A image via Dockerfile ENV
# (WEB_HOST=0.0.0.0, WEB_PORT=8000) — do NOT set these here; Traefik routes
# to container port 8000 directly and no host port is ever published.

# ============================================================================
# GitHub OAuth-логин (REQUIRED, EXTERNAL) — Stage 6B
# ============================================================================
# Отдельное OAuth App для продакшна (никогда общий с dev):
# https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Точно совпадает с Authorization callback URL, зарегистрированным в
# настройках OAuth App. Production: только https://.
GITHUB_REDIRECT_URI=https://learn.elivcloud.org/api/auth/github/callback

# Числовые GitHub user id, через запятую, кому разрешён доступ к
# web-приложению (never login/username — он может измениться). ВАЖНО:
# пусто = вход запрещён всем (fail closed), а не "всем разрешено".
# Продукт private/invite-only: успешной GitHub OAuth-аутентификации
# самой по себе недостаточно для доступа — см. utils/github_access_control.py.
# REQUIRED для того, чтобы web-вход вообще был кому-то доступен (тот же
# статус, что и TELEGRAM_ALLOWED_USER_IDS выше для Telegram-канала).
GITHUB_ALLOWED_USER_IDS=

# OPTIONAL — OAuth transaction TTL, seconds (default 600, max 900).
# GITHUB_OAUTH_TRANSACTION_TTL_SECONDS=600

# OPTIONAL — admission-control bounds for GET /api/auth/github/login
# (fail closed on invalid/non-positive values).
# GITHUB_OAUTH_MAX_STARTS_PER_MINUTE=30
# GITHUB_OAUTH_MAX_OUTSTANDING_TRANSACTIONS=200

# ============================================================================
# Логирование (OPTIONAL)
# ============================================================================
# LOG_LEVEL=INFO

# ============================================================================
# Режим/голос по умолчанию (OPTIONAL, не пишутся в БД как таковые)
# ============================================================================
# BOT_MODE=text
# DEFAULT_VOICE=alloy

# ============================================================================
# Traefik / ingress — DEPLOYMENT ONLY (read by docker-compose.prod.yml for
# variable substitution, never by the application itself).
# ============================================================================
# REQUIRED, left EMPTY here on purpose — docker-compose.prod.yml uses
# required-variable syntax (${VAR:?...}) for all three, so `docker compose
# config`/`up`/`build` FAILS CLOSED with an explicit error while these are
# unset, instead of silently defaulting to an unverified guess.
#
# Before Stage 8C: confirm the REAL values on the target production server
# (`docker network ls` for the network name; inspect the existing Traefik
# stack / another proxied deployment's labels for the entrypoint and cert
# resolver names — see docs/PRODUCTION_DEPLOYMENT.md, section 4). The
# values below are NOT confirmed production facts — do not fill them in
# from guesswork or copy them from a dev machine; get them from the actual
# server this stack will run on.
TRAEFIK_NETWORK_NAME=
TRAEFIK_ENTRYPOINT=
TRAEFIK_CERT_RESOLVER=

# ============================================================================
# Production image reference — DEPLOYMENT ONLY (OPTIONAL)
# ============================================================================
# Defaults to a local build tag. Set to a registry reference
# (e.g. a pinned digest) once this application is pushed to a registry.
# APP_IMAGE=multimodal-learning-assistant:latest
